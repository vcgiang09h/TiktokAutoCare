<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- ── 1. Popup Card (Độ rộng vừa vặn 235dp) ── -->
    <LinearLayout
        android:id="@+id/layoutCard"
        android:layout_width="235dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_widget"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- ── Header Bar ── -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Nút Thu nhỏ (-) -->
            <TextView
                android:id="@+id/btnMinimize"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_control_btn"
                android:gravity="center"
                android:text="—"
                android:textColor="#FFB300"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Nút Play / Pause -->
            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_control_btn_play"
                android:contentDescription="Play hoặc Pause"
                android:padding="5dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_play" />

            <!-- Nút Đóng (X) -->
            <TextView
                android:id="@+id/btnClose"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_control_btn"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ── Body Panel ── -->
        <LinearLayout
            android:id="@+id/layoutBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="#26FFFFFF" />

            <!-- Dòng 1: Thời gian (Không icon) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Thời gian:"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#00E676"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Dòng 2: Trạng thái (Không icon) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trạng thái:"
                    android:textColor="#FFB300"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="Sẵn sàng"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Dòng 3: Đã xem (Không icon) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Đã xem:"
                    android:textColor="#777788"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 video • 0 tim • 0 lưu"
                    android:textColor="#9999AA"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ── 2. Minimized Floating Bubble Icon (Hình vuông bo góc, icon tràn đầy) ── -->
    <FrameLayout
        android:id="@+id/layoutMinimizedIcon"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_floating_bubble"
        android:clipToOutline="true"
        android:padding="2dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="AutoCare"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />
    </FrameLayout>

</FrameLayout>
